#include "midnight52.dtsi"

&default_transform {
    col-offset = <0>;
};

&kscan0 {
    /*
     * Cols are inputs (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN).
     * pro_micro pin numbers match Arduino labels on board silkscreen.
     * 8=P1.04, 7=P0.11, 6=P1.00, 5=P0.24, 4=P0.22, 15=P1.13, 14=P1.11, 16=P0.10
     */
    col-gpios
        = <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 1 - D8  */
        , <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 2 - D7  */
        , <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 3 - D6  */
        , <&pro_micro 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 4 - D5  */
        , <&pro_micro 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 5 - D4  */
        , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 6 - D15 */
        , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 7 - D14 (dead rows 1-3) */
        , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 8 - D16 (dead rows 1-3) */
        ;
};
