#include "midnight52.dtsi"

&default_transform {
    col-offset = <0>;
};

&kscan0 {
    col-gpios
        = <&gpio0 28 GPIO_ACTIVE_HIGH>   /* Col 1 - Pro Micro 8  - P0.28 */
        , <&gpio1 14 GPIO_ACTIVE_HIGH>   /* Col 2 - Pro Micro 7  - P1.14 */
        , <&gpio1 13 GPIO_ACTIVE_HIGH>   /* Col 3 - Pro Micro 6  - P1.13 */
        , <&gpio1 12 GPIO_ACTIVE_HIGH>   /* Col 4 - Pro Micro 5  - P1.12 */
        , <&gpio1 11 GPIO_ACTIVE_HIGH>   /* Col 5 - Pro Micro 4  - P1.11 */
        , <&gpio0 8  GPIO_ACTIVE_HIGH>   /* Col 6 - Pro Micro 15 - P0.08 */
        , <&gpio0 20 GPIO_ACTIVE_HIGH>   /* Col 7 - Pro Micro 14 - P0.20 (dead rows 1-3) */
        , <&gpio1 10 GPIO_ACTIVE_HIGH>   /* Col 8 - Pro Micro 16 - P1.10 (dead rows 1-3) */
        ;
};
