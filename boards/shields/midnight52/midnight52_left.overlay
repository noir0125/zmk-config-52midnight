#include "midnight52.dtsi"

&default_transform {
    col-offset = <0>;
};

&kscan0 {
    col-gpios
        = <&gpio1 4  GPIO_ACTIVE_HIGH>   /* Col 1 - D8  - P1.04 */
        , <&gpio1 0  GPIO_ACTIVE_HIGH>   /* Col 2 - D7  - P1.00 */
        , <&gpio0 24 GPIO_ACTIVE_HIGH>   /* Col 3 - D6  - P0.24 */
        , <&gpio0 22 GPIO_ACTIVE_HIGH>   /* Col 4 - D5  - P0.22 */
        , <&gpio0 20 GPIO_ACTIVE_HIGH>   /* Col 5 - D4  - P0.20 */
        , <&gpio1 13 GPIO_ACTIVE_HIGH>   /* Col 6 - D15 - P1.13 */
        , <&gpio1 11 GPIO_ACTIVE_HIGH>   /* Col 7 - D14 - P1.11 (dead rows 1-3) */
        , <&gpio0 10 GPIO_ACTIVE_HIGH>   /* Col 8 - D16 - P0.10 (dead rows 1-3) */
        ;
};
