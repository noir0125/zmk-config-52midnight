#include "midnight52.dtsi"

&default_transform {
    col-offset = <8>;
};

&kscan0 {
    /*
     * Cols are inputs (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN).
     * pro_micro pin numbers match Arduino labels on board silkscreen.
     * 15=P1.13, 14=P1.11, 16=P0.10, 2=P0.17, 3=P0.20, 4=P0.22, 5=P0.24, 6=P1.00
     */
    col-gpios
        = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 1 - D15 */
        , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 2 - D14 */
        , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 3 - D16 */
        , <&pro_micro 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 4 - D2  */
        , <&pro_micro 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 5 - D3  */
        , <&pro_micro 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 6 - D4  */
        , <&pro_micro 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 7 - D5  (dead rows 1-3) */
        , <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 8 - D6  (dead rows 1-3) */
        ;
};
