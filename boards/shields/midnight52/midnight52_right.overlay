#include "midnight52.dtsi"

&default_transform {
    col-offset = <8>;
};

&kscan0 {
    col-gpios
        = <&gpio1 13 GPIO_ACTIVE_LOW>   /* Col 1 - D15 - P1.13 */
        , <&gpio1 11 GPIO_ACTIVE_LOW>   /* Col 2 - D14 - P1.11 */
        , <&gpio0 10 GPIO_ACTIVE_LOW>   /* Col 3 - D16 - P0.10 */
        , <&gpio0 17 GPIO_ACTIVE_LOW>   /* Col 4 - D2  - P0.17 */
        , <&gpio0 20 GPIO_ACTIVE_LOW>   /* Col 5 - D3  - P0.20 */
        , <&gpio0 22 GPIO_ACTIVE_LOW>   /* Col 6 - D4  - P0.22 */
        , <&gpio0 24 GPIO_ACTIVE_LOW>   /* Col 7 - D5  - P0.24 (dead rows 1-3) */
        , <&gpio1 0  GPIO_ACTIVE_LOW>   /* Col 8 - D6  - P1.00 (dead rows 1-3) */
        ;
};
