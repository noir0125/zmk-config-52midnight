#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * Layout (52 keys, dead positions skipped):
         *
         * Left rows 1-3 (6 keys each):              Right rows 1-3 (6 keys each):
         * ESC  1    2    3    4    5                  ?    0    9    8    7    6
         * TAB  Q    W    E    R    T                  UE   P    O    I    U    Z
         * SHFT A    S    D    F    G                  AE   OE   L    K    J    H
         *
         * Left row 4 (8 keys):                       Right row 4 (8 keys):
         * Z    X    C    V    B    UP   SPC  DOWN     MINS DOT  COMM M    N    RGHT SPC  LEFT
         */
        default_layer {
            bindings = <
                &kp ESC  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                              &kp QMARK &kp N0   &kp N9   &kp N8 &kp N7 &kp N6
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T                               &kp LBKT  &kp P    &kp O    &kp I  &kp U  &kp Y
                &kp LSFT &kp A  &kp S  &kp D  &kp F  &kp G                               &kp SQT   &kp SEMI &kp L    &kp K  &kp J  &kp H
                &kp Z    &kp X  &kp C  &kp V  &kp B  &kp UP &kp SPACE &kp DOWN    &kp MINUS &kp DOT &kp COMMA &kp M &kp N &kp RIGHT &kp SPACE &kp LEFT
            >;
        };
    };
};
